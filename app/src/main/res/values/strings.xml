    <string name="app_name">Artifact MCP</string>

    <string name="setup_title">Connect to a server</string>
    <string name="setup_intro">Enter the address of your Artifact MCP server. It must start with https://.</string>
    <string name="setup_hint">Server address, for example https://artifact.example.com</string>
    <string name="setup_continue">Continue</string>
    <string name="setup_note">The app opens this server\'s gallery and signs in with the server\'s own login page. You can change the server later in Settings.</string>
    <string name="setup_error_https">Use an https:// address.</string>
    <string name="setup_error_path">Enter only the server address, without a path or query.</string>
    <string name="setup_error_userinfo">Do not put a user name or password in the address.</string>
    <string name="setup_error_malformed">This is not a valid server address.</string>
