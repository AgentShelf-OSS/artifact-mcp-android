<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. The configured origin must be https (enforced in OriginPolicy as well). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
